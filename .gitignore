# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Visual Studio / Rider project files
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.idea/
*.iml
*.ipr

# Unity Asset Store files
/[Aa]ssets/AssetStoreTools*

# Auto-generated files by Unity
/Assets/Plugins/Android/*.gradle
/Assets/Plugins/Android/*.meta
/Assets/Plugins/iOS/*.meta

# OS generated files
.DS_Store
Thumbs.db

# Logs and crash reports
*.log
*.stacktrace

# Node.js backend files (if applicable)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
*.apk
*.aab
*.ipa

# Unity Cloud Build
[Uu]ser[Ss]ettings/

# JetBrains Rider
.idea/
*.dotSettings.user

# TextMeshPro generated files
/Assets/TextMesh Pro/Resources/*.asset

# Exclude sensitive files
*.key
*.pem
*.p12
.env

# Ignore Unity's Collaborate files
/[Cc]ollab/

# Ignore PlayerPrefs backup files
*.prefs

# React-specific files
/build/
/dist/
/coverage/
/.env.local
/.env.development.local
/.env.test.local
/.env.production.local

# React cache files
.cache/
.parcel-cache/

# Temporary files
*.swp

# Custom ignores
# Ignore the specific ServerConfig asset containing sensitive URLs
Assets/Configuration/ServerConfig.asset # Adjust path if you saved it elsewhere